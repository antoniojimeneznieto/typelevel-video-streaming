{
  "realm": "typelevel-video-streaming",
  "displayName": "Typelevel Video Streaming",
  "enabled": true,
  "loginTheme": "typelevel-video-streaming",

  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,

  "sslRequired": "none",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 1209600,
  "ssoSessionMaxLifespanRememberMe": 2592000,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@typelevel.org",
    "fromDisplayName": "Typelevel",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform administrator"
      },
      {
        "name": "creator",
        "description": "Video creator"
      },
      {
        "name": "user",
        "description": "Default authenticated user"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-typelevel-video-streaming",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "containerId": "typelevel-video-streaming",
        "composites": {
          "realm": ["user", "offline_access", "uma_authorization"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      }
    ]
  },

  "defaultRole": {
    "name": "default-roles-typelevel-video-streaming",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "typelevel-video-streaming"
  },

  "clients": [
    {
      "clientId": "tvs-web",
      "name": "Typelevel Video Streaming Web (public SPA)",
      "description": "Scala.js + Calico SPA. Authorization Code + PKCE (S256).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:4500",
      "baseUrl": "http://localhost:4500",
      "redirectUris": [
        "http://localhost:4500/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4500/*##http://localhost:3000/*##http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "aud-resource-servers",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "user-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "user-service-admin",
      "name": "User Service Admin",
      "description": "client_credentials admin token for user-service. Least-privilege: manage-users, view-users, query-users.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "user-service-admin-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true
    }
  ],

  "users": [
    {
      "username": "service-account-user-service-admin",
      "enabled": true,
      "serviceAccountClientId": "user-service-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
