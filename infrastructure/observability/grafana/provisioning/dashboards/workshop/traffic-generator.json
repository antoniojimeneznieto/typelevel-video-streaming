{
  "uid": "workshop-traffic-generator",
  "title": "Workshop Traffic",
  "tags": [
    "workshop",
    "traffic"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Workshop Overview",
      "url": "/d/workshop-overview/workshop-overview",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Generator offered arrivals and sent requests",
      "description": "Offered includes arrivals dropped by the generator. Gateway client attempts can exceed logical requests when retries are enabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_traffic_arrivals_total{profile=~\"$profile\"}[$metric_window]))",
          "legendFormat": "Offered arrivals"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_traffic_arrivals_total{profile=~\"$profile\",result=\"sent\"}[$metric_window]))",
          "legendFormat": "Sent requests"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Client request outcomes and generator drops",
      "description": "Dropped capacity or late arrivals invalidate the offered-load comparison. A blank series means no observed event of that kind; inspect the JSON summary for exact run totals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^identity\\-current\\-user .+$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /users/me ${__field.labels.outcome}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^identity\\-login .+$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "POST /auth/login ${__field.labels.outcome}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^catalog\\-courses .+$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /courses ${__field.labels.outcome}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^catalog\\-learning\\-paths .+$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /learning-paths ${__field.labels.outcome}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^playback\\-favorites .+$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /favorites ${__field.labels.outcome}"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(lab_traffic_requests_total{profile=~\"$profile\"}[$metric_window]))",
          "legendFormat": "{{operation}} {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (rate(lab_traffic_arrivals_total{profile=~\"$profile\",result=~\"dropped_capacity|dropped_late\"}[$metric_window]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(lab_traffic_cancellations_total{profile=~\"$profile\"}[$metric_window]))",
          "legendFormat": "cancelled"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP request p95 measured from client",
      "description": "Traffic-generator duration through Gateway until the response body is consumed or the request fails/times out. Endpoint names identify the downstream service route; Gateway adds /api/identity, /api/catalog, or /api/playback. Setup and token renewal are excluded; dropped arrivals are not timed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "identity-current-user p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /users/me p95 from client"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "identity-login p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "POST /auth/login p95 from client"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "catalog-courses p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /courses p95 from client"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "catalog-learning-paths p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /learning-paths p95 from client"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "playback-favorites p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GET /favorites p95 from client"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,operation) (rate(lab_traffic_request_duration_seconds_bucket{profile=~\"$profile\"}[$metric_window])))",
          "legendFormat": "{{operation}} p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Client HTTP requests in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "requests"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lab_traffic_requests_active{profile=~\"$profile\"})",
          "legendFormat": "Client requests in flight"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metric_window",
        "label": "Metric window",
        "type": "custom",
        "query": "15s,30s,60s",
        "includeAll": false,
        "multi": false,
        "current": { "text": "30s", "value": "30s" }
      },
      {
        "name": "profile",
        "label": "Profile",
        "type": "custom",
        "query": "catalog-courses,catalog-reads,catalog-soak,identity,playback",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
