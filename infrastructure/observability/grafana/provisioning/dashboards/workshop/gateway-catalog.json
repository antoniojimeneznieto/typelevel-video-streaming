{
  "uid": "gateway-catalog-boundary",
  "title": "Gateway–Catalog: Request Path",
  "tags": ["workshop", "gateway", "catalog"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Workshop Overview", "url": "/d/workshop-overview/workshop-overview", "targetBlank": false, "keepTime": true, "includeVars": true },
    { "title": "Workshop Traffic", "url": "/d/workshop-traffic-generator/workshop-traffic", "targetBlank": false, "includeVars": true }
  ],
  "templating": { "list": [
    { "name": "metric_window", "label": "Metric window", "type": "custom", "query": "15s,30s,60s", "includeAll": false, "multi": false, "current": { "text": "30s", "value": "30s" } }
  ] },
  "panels": [
    {
      "id": 5,
      "type": "timeseries",
      "title": "Catalog read p95 across the boundary",
      "description": "Compare gateway server, Gateway Catalog client, and Catalog server p95 over the selected metric window. Their difference suggests where to investigate; it is not an exact per-request decomposition. Short windows can jump when traffic is sparse. Click an exemplar for a representative trace.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"gateway-service\",classifier=\"/api/catalog/courses\",http_phase=\"body\"}[$metric_window])))", "legendFormat": "gateway server p95", "exemplar": true },
        { "refId": "B", "expr": "histogram_quantile(0.95,sum by (le) (rate(http_client_request_duration_seconds_bucket{service_name=\"gateway-service\",classifier=\"catalog:/courses\",http_phase=\"body\"}[$metric_window])))", "legendFormat": "gateway Catalog client p95", "exemplar": true },
        { "refId": "C", "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"catalog-service\",classifier=\"/courses\",http_phase=\"body\"}[$metric_window])))", "legendFormat": "Catalog server p95", "exemplar": true }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Offered load and request rates",
      "description": "One Catalog read currently makes one outbound attempt. Compare offered arrivals, sent requests, Gateway inbound, Gateway client attempts, and Catalog server requests over the selected metric window. Missing series are unknown, not zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(lab_traffic_arrivals_total{profile=\"catalog-courses\"}[$metric_window]))", "legendFormat": "offered" },
        { "refId": "B", "expr": "sum(rate(lab_traffic_arrivals_total{profile=\"catalog-courses\",result=\"sent\"}[$metric_window]))", "legendFormat": "sent" },
        { "refId": "C", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=\"/api/catalog/courses\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "gateway inbound" },
        { "refId": "D", "expr": "sum(rate(http_client_request_duration_seconds_count{service_name=\"gateway-service\",classifier=\"catalog:/courses\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "gateway Catalog attempts" },
        { "refId": "E", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"catalog-service\",classifier=\"/courses\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "Catalog server" }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Recent Gateway to Catalog traces",
      "description": "Recent course-read traces from Gateway. Open one from the period under investigation and compare the Gateway Catalog client span, Catalog server child, and SQL spans. The most recent trace is not necessarily the p95 request.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 10 },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ resource.service.name = \"gateway-service\" && name = \"GET /api/catalog/courses\" } with (most_recent=true)", "tableType": "traces", "limit": 10 }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Trace investigation",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 5 },
      "options": { "mode": "markdown", "content": "Select a 15s, 30s, or 60s metric window above. A shorter window reacts sooner but can fluctuate more with sparse traffic; a longer window retains older observations. Open a recent trace from the table or click a latency exemplar, then compare the Gateway Catalog client span with its Catalog server child and SQL spans. Choose a trace from the period under investigation." }
    }
  ]
}
