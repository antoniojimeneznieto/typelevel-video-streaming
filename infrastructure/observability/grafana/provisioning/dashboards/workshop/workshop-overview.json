{
  "uid": "workshop-overview",
  "title": "Workshop Overview",
  "tags": [
    "workshop",
    "red",
    "http"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Workshop Traffic",
      "url": "/d/workshop-traffic-generator/workshop-traffic",
      "targetBlank": false,
      "includeVars": true
    },
    {
      "title": "Gateway–Catalog: Request Path",
      "url": "/d/gateway-catalog-boundary/gatewaye28093-catalog3a-request-path",
      "targetBlank": false,
      "includeVars": true
    },
    {
      "title": "Identity: Login Latency",
      "url": "/d/identity-investigation/identity3a-login-latency",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Playback: Favorites Authentication",
      "url": "/d/playback-investigation/playback3a-favorites-authentication",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Catalog: Session Pool",
      "url": "/d/catalog-sessions/catalog3a-session-pool",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Cats Effect Runtime Metrics",
      "url": "/d/cats-effect-runtime/cats-effect-runtime-metrics",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "JVM Runtime Metrics",
      "url": "/d/jvm-runtime/jvm-runtime-metrics",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metric_window",
        "label": "Metric window",
        "type": "custom",
        "query": "15s,30s,60s",
        "includeAll": false,
        "multi": false,
        "current": { "text": "30s", "value": "30s" }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "gateway-service,identity-service,catalog-service,playback-service",
        "includeAll": true,
        "allValue": "gateway-service|identity-service|catalog-service|playback-service",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service\",http_phase=\"body\"}, classifier)",
          "refId": "RouteVariable"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service\",http_phase=\"body\"}, http_request_method)",
          "refId": "MethodVariable"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "custom",
        "query": "All",
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "All"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Workshop orientation",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Overall request rate",
      "description": "Completed response rate. No series means no telemetry; a visible zero means measured traffic with no requests in the rate window.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "Success",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\",http_response_status_code=~\"2..|3..\"}[$metric_window]))",
          "legendFormat": "successful",
          "exemplar": true
        },
        {
          "refId": "Failure",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\",http_response_status_code=~\"4..|5..\"}[$metric_window]))",
          "legendFormat": "failed",
          "exemplar": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Overall server error percentage",
      "description": "5xx responses divided by all completed responses. 4xx responses are visible separately and do not count as server errors.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\",http_response_status_code=~\"5..\"}[$metric_window])) / sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Platform p95 duration",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Platform p99 duration",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active requests",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "requests",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_active_requests{service_name=~\"$service\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Telemetry freshness",
      "description": "Age of the newest completed HTTP metric sample. No value means the metric pipeline is absent.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(timestamp(http_server_request_duration_seconds_count{service_name=~\"$service\",http_phase=\"body\"}))"
        }
      ]
    },
    {
      "type": "row",
      "title": "RED by service",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Rates use the selected Metric window. Try 15s, 30s, and 60s while traffic changes: shorter windows react sooner but fluctuate more. This selector changes the query lookback, not the five-second metric export interval.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))",
          "legendFormat": "{{service_name}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP error percentage by status",
      "description": "4xx and 5xx shares of all selected server requests. Status series are stacked; use Playback: Favorites Authentication for the single-service 401 evidence.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\",http_response_status_code=~\"[45]..\"}[$metric_window])) / scalar(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))",
          "legendFormat": "HTTP {{http_response_status_code}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duration by service",
      "description": "Histogram p50, p95, and p99 over the selected Metric window. Compare 15s, 30s, and 60s around a fault and its recovery; old observations stay in longer windows longer. Sparse traffic can make short-window percentiles jump.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 14
      },
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.50, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))",
          "legendFormat": "{{service_name}} p50",
          "exemplar": true
        },
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))",
          "legendFormat": "{{service_name}} p95",
          "exemplar": true
        },
        {
          "refId": "p99",
          "expr": "histogram_quantile(0.99, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window])))",
          "legendFormat": "{{service_name}} p99",
          "exemplar": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Operation comparison",
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Slowest HTTP operations (p99)",
      "description": "Bounded, metric-derived p99 by stable server classifier. Use the trace link below for representative traces.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, histogram_quantile(0.99, sum by (service_name, classifier, http_request_method, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Route request rate",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))",
          "legendFormat": "{{classifier}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Route 4xx/5xx percentage",
      "description": "Per-route 4xx and 5xx responses; split by exact status code. Select one service to avoid merging identically named routes across services.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (classifier, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\",http_response_status_code=~\"[45]..\"}[$metric_window])) / ignoring(http_response_status_code) group_left sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))",
          "legendFormat": "{{classifier}} HTTP {{http_response_status_code}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Route latency heatmap",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",classifier=~\"$route\",http_request_method=~\"$method\",http_phase=\"body\"}[$metric_window]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traces, logs, and navigation",
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "text",
      "title": "Representative traces and recent errors",
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Use **Explore → Tempo** to search `service.name` and the stable `http.route` selected above, and **Explore → Loki** with the same service and time range for application errors.\n\nError policy: 5xx is a server error; 4xx is displayed in request-rate panels but excluded from server-error percentage. Transport failures and cancellation need the pending bounded outcome metric before they can contribute to the rate."
      }
    }
  ]
}
