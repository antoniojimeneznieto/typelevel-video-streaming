{
  "uid": "catalog-sessions",
  "title": "Catalog: Session Pool",
  "tags": ["workshop", "catalog", "postgresql"],
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Workshop Overview", "url": "/d/workshop-overview/workshop-overview", "targetBlank": false, "keepTime": true, "includeVars": true },
    { "title": "Workshop Traffic", "url": "/d/workshop-traffic-generator/workshop-traffic", "targetBlank": false, "includeVars": true }
  ],
  "templating": { "list": [
    { "name": "metric_window", "label": "Metric window", "type": "custom", "query": "15s,30s,60s", "includeAll": false, "multi": false, "current": { "text": "30s", "value": "30s" } }
  ] },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Completed Gateway requests per second, including failures and timeouts. This is observed throughput, not the offered workload rate; compare with active requests when requests stall.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "{{classifier}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failure rate by endpoint",
      "description": "Percentage of completed Gateway requests returning HTTP 4xx or 5xx, including 504 deadlines. Endpoints with traffic and no failures show zero; endpoints without traffic have no defined failure percentage.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "100 * (sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\",http_response_status_code=~\"[45]..\"}[$metric_window])) or 0 * sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\"}[$metric_window]))) / sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "{{classifier}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request timeouts by endpoint (HTTP 504)",
      "description": "Gateway upstream deadlines per second for each Catalog endpoint. Read these at the Gateway: a canceled Catalog request may never produce an HTTP error response. Zero is shown for observed endpoints without timeouts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\",http_response_status_code=\"504\"}[$metric_window])) or 0 * sum by (classifier) (rate(http_server_request_duration_seconds_count{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\",http_phase=\"body\"}[$metric_window]))", "legendFormat": "{{classifier}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active requests by endpoint",
      "description": "In-flight HTTP requests summed across instances, shown separately at Gateway and Catalog. Rising active requests with flat throughput reveal requests piling up behind the exhausted pool.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "sum by (classifier) (http_server_active_requests{service_name=\"gateway-service\",classifier=~\"/api/catalog/(courses|learning-paths)\"})", "legendFormat": "Gateway {{classifier}}" },
        { "refId": "B", "expr": "sum by (classifier) (http_server_active_requests{service_name=\"catalog-service\",classifier=~\"/courses|/learning-paths\"})", "legendFormat": "Catalog {{classifier}}" }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Catalog session pool occupancy",
      "description": "Combined checked-out sessions and capacity across Catalog instances whose pool capacity is positive. Retired pools with zero capacity are excluded. Queued requests use the right axis so they do not flatten the six-slot pool. Recovery means checked-out sessions fall below capacity and the queue drains under the same workload.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "axisLabel": "Sessions" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "waiting" }, "properties": [
            { "id": "custom.axisPlacement", "value": "right" },
            { "id": "custom.axisLabel", "value": "Queued requests" }
          ] }
        ]
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "sum(catalog_session_active{service_name=\"catalog-service\"} and on (service_name, service_instance_id) (catalog_session_capacity{service_name=\"catalog-service\"} > 0))", "legendFormat": "checked out" },
        { "refId": "B", "expr": "sum(catalog_session_waiting{service_name=\"catalog-service\"} and on (service_name, service_instance_id) (catalog_session_capacity{service_name=\"catalog-service\"} > 0))", "legendFormat": "waiting" },
        { "refId": "C", "expr": "sum(catalog_session_capacity{service_name=\"catalog-service\"} > 0)", "legendFormat": "capacity" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Session acquisition p95",
      "description": "Finished acquisition attempts, including cancellation and failure. Attempts still waiting have no duration observation; use oldest active wait below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95,sum by (le) (rate(catalog_session_acquire_duration_seconds_bucket{service_name=\"catalog-service\"}[$metric_window])))", "legendFormat": "acquire p95" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Catalog route p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95,sum by (le,classifier) (rate(http_server_request_duration_seconds_bucket{service_name=\"catalog-service\",classifier=~\"/courses|/learning-paths\",http_phase=\"body\"}[$metric_window])))", "legendFormat": "{{classifier}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest active session wait",
      "description": "This live wait age rises while Catalog requests remain queued for a session, even before an acquisition completes or times out.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(catalog_session_wait_max_age_seconds{service_name=\"catalog-service\"} and on (service_name, service_instance_id) (catalog_session_capacity{service_name=\"catalog-service\"} > 0))", "legendFormat": "oldest wait" }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent healthy Catalog traces",
      "description": "Successful Gateway course and LearningPath reads. Open a recent trace to compare Catalog session acquisition and SQL spans with the affected period.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 12, "y": 42, "w": 12, "h": 10 },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ resource.service.name = \"gateway-service\" && name =~ \"GET /api/catalog/(courses|learning-paths)\" && span.http.response.status_code = 200 } with (most_recent=true)", "tableType": "traces", "limit": 10 }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent failing Catalog traces",
      "description": "Gateway course and LearningPath reads that reached the upstream deadline and returned HTTP 504. Compare available Catalog and SQL spans with pool occupancy and wait age; canceled requests may have incomplete child spans.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 42, "w": 12, "h": 10 },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ resource.service.name = \"gateway-service\" && name =~ \"GET /api/catalog/(courses|learning-paths)\" && span.http.response.status_code = 504 } with (most_recent=true)", "tableType": "traces", "limit": 10 }
      ]
    }
  ]
}
