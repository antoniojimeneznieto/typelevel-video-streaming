+  test(
+    "diagnostics distinguish JWT rejection from subject rejection without repairing the decoder",
+  ) {
+    import AccessTokenVerifier.Stage
+    keys.flatMap { pair =>
+      for
+        observed <- Ref.of[IO, Vector[(Stage, Boolean)]](Vector.empty)
+        legacy    = AccessTokenVerifier
+                   .userId(publicKey(pair), issuer, audience)
+                   .withDiagnostics((stage, accepted) => observed.update(_ :+ (stage -> accepted)))
+        modern           = claims(Instant.now()).withSubject(s"user:$userId").sign(algorithm(pair))
+        rejected        <- legacy.verify(modern)
+        stages          <- observed.getAndSet(Vector.empty)
+        malformed       <- legacy.verify("not-a-jwt")
+        malformedStages <- observed.getAndSet(Vector.empty)
+        compatible       =
+          AccessTokenVerifier
+            .userIdCompatible(publicKey(pair), issuer, audience)
+            .withDiagnostics((stage, accepted) => observed.update(_ :+ (stage -> accepted)))
+        accepted       <- compatible.verify(modern)
+        repairedStages <- observed.get
+      yield expect.all(
+        rejected.isEmpty,
+        stages == Vector(Stage.JwtVerification -> true, Stage.SubjectDecoding -> false),
+        malformed.isEmpty,
+        malformedStages == Vector(Stage.JwtVerification -> false),
+        accepted.contains(userId),
+        repairedStages == Vector(
+          Stage.JwtVerification -> true,
+          Stage.SubjectDecoding -> true,
+          Stage.ClaimsValidation -> true,
+          Stage.PrincipalDecoding -> true,
+        ),
+      )
+    }
+  }
