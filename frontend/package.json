{
  "name": "typelevel-video-streaming-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "cd .. && sbt --batch frontend/fastLinkJS",
    "dev": "vite",
    "dev:scala": "cd .. && sbt '~frontend/fastLinkJS'",
    "prebuild": "cd .. && sbt --server --batch -J-Xmx2G -J-XX:+ExitOnOutOfMemoryError frontend/fullLinkJS",
    "build": "vite build",
    "preview": "vite preview",
    "test": "cd .. && sbt frontend/test"
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
